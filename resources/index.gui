<svg class="application" viewBox="0 0 348 250">
  <!-- Background -->
  <rect id="background" x="0" y="0" width="100%" height="100%" fill="#000000" />

  <!-- Title -->
  <text id="title-text" x="50%" y="30" fill="white" font-size="24"
        font-family="System-Bold" text-anchor="middle" text-length="32">
    URGE METER
  </text>

  <!-- Level indicator bar -->
  <rect id="level-bar" x="24" y="55" width="300" height="80" rx="12" ry="12"
        fill="#4CAF50" />

  <!-- Level text overlay -->
  <text id="level-text" x="50%" y="105" fill="white" font-size="40"
        font-family="System-Bold" text-anchor="middle" text-length="20">
    NONE
  </text>

  <!-- Down button -->
  <rect id="btn-down" x="24" y="160" width="140" height="64" rx="10" ry="10"
        fill="#333333" pointer-events="visible" />
  <text x="94" y="200" fill="white" font-size="28"
        font-family="System-Bold" text-anchor="middle" text-length="10">
    ▼ DOWN
  </text>

  <!-- Up button -->
  <rect id="btn-up" x="184" y="160" width="140" height="64" rx="10" ry="10"
        fill="#333333" pointer-events="visible" />
  <text x="254" y="200" fill="white" font-size="28"
        font-family="System-Bold" text-anchor="middle" text-length="10">
    ▲ UP
  </text>
</svg>
